SQL: CREATE TABLE lakekeeper.silver.order_lines
WITH (format = 'PARQUET', partitioning = ARRAY['month(orderdate)']) AS
SELECT
    l.orderkey,
    l.linenumber,
    o.custkey,
    o.orderdate,
    upper(trim(o.orderstatus))                                   AS orderstatus,
    trim(o.orderpriority)       
